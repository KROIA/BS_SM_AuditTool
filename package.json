{
  "name": "audit-tool",
  "private": true,
  "version": "0.1.0",
  "description": "Offline investigation tool for worlds that run BankSystem and StockMarket",
  "type": "module",
  "main": "dist/node/main/main.js",
  "scripts": {
    "build:node": "tsc -p tsconfig.node.json",
    "build:ui": "vite build",
    "build": "npm run build:node && npm run build:ui",
    "start": "npm run build && electron .",
    "check": "tsc -p tsconfig.test.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:ui": "npm run build && playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "electron": "^45.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
