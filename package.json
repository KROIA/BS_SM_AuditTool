{
  "name": "audit-tool",
  "private": true,
  "version": "1.1.0",
  "description": "Offline audit tool for Minecraft servers running BankSystem and StockMarket: finds exploits and cheats in copies of the saves, follows the money and items, and reports what to take back",
  "type": "module",
  "main": "dist/node/main/main.js",
  "scripts": {
    "build:node": "tsc -p tsconfig.node.json",
    "build:ui": "vite build",
    "build": "npm run build:node && npm run build:ui",
    "start": "npm run build && electron .",
    "check": "tsc -p tsconfig.test.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:ui": "npm run build && playwright test",
    "dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && electron-builder --win --x64",
    "test:release": "playwright test -c playwright.release.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "electron": "^45.3.1",
    "electron-builder": "26.18.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  },
  "build": {
    "productName": "Audit Tool",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/svelte/LICENSE.md",
        "to": "licenses/svelte-LICENSE.md"
      },
      {
        "from": "node_modules/@fontsource-variable/inter/LICENSE",
        "to": "licenses/inter-LICENSE.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/jetbrains-mono/LICENSE",
        "to": "licenses/jetbrains-mono-LICENSE.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/space-grotesk/LICENSE",
        "to": "licenses/space-grotesk-LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    }
  }
}
